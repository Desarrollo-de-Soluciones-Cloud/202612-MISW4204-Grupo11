HTTP_ADDR=:8080
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
GCP_PROJECT_ID=local-project
PUBSUB_TOPIC_ID=reports
PUBSUB_SUBSCRIPTION_ID=reports-weekly-generate
# En producción (GKE/Cloud Run) omitir PUBSUB_EMULATOR_HOST.
# Para desarrollo local con docker-compose se setea automáticamente.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
GCS_BUCKET=
GCS_REPORTS_PREFIX=reports

# Obligatorio: firma de los JWT (cadena larga y secreta).
JWT_SECRET=

# Groq (IA para reportes). API key gratis en https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ejemplo local (NO versionar valores reales):
# POSTGRES_USER=app
# POSTGRES_PASSWORD=cambia-esto-local
# POSTGRES_DB=app
# DATABASE_URL=postgres://app:cambia-esto-local@postgres:5432/app?sslmode=disable
# JWT_SECRET=desarrollo-cambia-esto-por-algo-largo-y-secreto
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
